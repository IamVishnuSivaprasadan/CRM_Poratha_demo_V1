# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Authentication secret for JWT tokens
JWT_SECRET=poratha_corp_super_secret_jwt_key_2026_production

# Storage provider configuration: 'local' (default) or 's3'
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Database URL for PostgreSQL (optional, defaults to built-in transactional persistent store in ./storage/poratha.db.json)
DATABASE_URL=postgresql://poratha:poratha_secret@localhost:5432/poratha_docs

